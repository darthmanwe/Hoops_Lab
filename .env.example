# =========================
# HoopsLab Local Environment
# =========================
#
# Copy to .env for local development. Do not commit real secrets.
#
# Nothing here is required to run the project. `npm run test` and
# `uv run pytest` pass with this file absent, no network and no credentials.

# ---- Web ----
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8787

# ---- Cloudflare (deploys and D1 operations only) ----
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ---- Scouting reports (phase 6) ----
# Only needed to refresh the response cache. The committed cache means the demo
# and the full evaluation suite run at zero cost without this set.
ANTHROPIC_API_KEY=

# ---- Python service ----
# HOOPSLAB_LOG_LEVEL=INFO
# HOOPSLAB_NBA_STATS_RATE_LIMIT_RPS=0.67

# Removed: BALLDONTLIE_API_KEY. It was declared here, in .dev.vars.example, in
# the Worker's Env type and in the ETL config, and no code ever read it.
