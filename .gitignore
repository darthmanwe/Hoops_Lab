# Data lake: bronze (raw API payloads) and silver (typed intermediates) are
# regenerable from `npm run ingest` and are far too large to commit. Only
# data/gold/ is committed, so that a clean clone reproduces every reported
# number with no network access.
data/bronze/
data/silver/
data/external/
services/ml/runs/scratch/
services/ml/reports/scratch/

# Playwright
test-results/
playwright-report/
blob-report/
data/d1/

# Next.js 16 regenerates these agent-rules files on every dev/build run. They
# are tool scaffolding rather than project content, and committing them means
# a diff every time anyone starts the dev server.
apps/web/AGENTS.md
apps/web/CLAUDE.md

# Personal marketing material. Copy for posts, and images sized for them.
# Not part of the project, and not something a clone should carry.
linkedin/

# Working note for picking this up later. Status, access and open items —
# useful on this machine, not something a clone should carry.
project_status.md
