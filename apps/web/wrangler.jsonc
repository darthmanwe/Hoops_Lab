{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hoopslab-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-02-25",

  // OpenNext runs the Next.js server, which needs Node built-ins. Without
  // this the build succeeds and the Worker fails at first request on a
  // missing `node:stream`.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },

  // Every page is a server component, so the API call is made by this Worker
  // rather than by the browser — and a Worker cannot reach another Worker on
  // the same account through its workers.dev address. The subrequest never
  // leaves the runtime; it loops back into this Worker, which has no /models
  // route and answers 404. From outside, curl gets a clean 200, so the failure
  // looks like a bad URL and is not one.
  //
  // A service binding is the supported way across, and is better than the fix
  // it replaces: no DNS, no TLS, no public round trip, and the API Worker stays
  // reachable by the browser for anything client-side later.
  "services": [
    {
      "binding": "API",
      "service": "hoopslab-api-production",
    },
  ],

  "observability": {
    "enabled": true,
  },

  // No API base is set here, deliberately. `NEXT_PUBLIC_*` is inlined by the
  // Next.js compiler at build time, not read from the Worker environment at
  // request time, so putting it in `vars` would produce a config that looks
  // authoritative and does nothing. It belongs in the build environment —
  // see `deploy:web` in the root package.json — and changing it requires
  // clearing `.next`, because a stale build will happily keep the old value.
}
