{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "jsx": "preserve",
    "allowJs": true,
    // Phase 5 migrates this app from .jsx to .tsx. Until then `checkJs` stays
    // off so the gate compiles from day one; flipping it on before the rename
    // would produce hundreds of errors and teach everyone to ignore the check.
    "checkJs": false,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", "src/**/*.js", "src/**/*.jsx"],
  "exclude": ["node_modules", ".next"]
}
